import os
import json
import time
import subprocess
import shutil
from PySide6.QtCore import QThread, Signal

class KaggleLyricsWorker(QThread):
    """
    Self-contained background thread that pipes audio transcription to 
    a remote Kaggle GPU container node instead of using local dependencies.
    Co-hosts both WhisperX and ACE-Step architectures within a single kernel frame.
    """
    progress = Signal(int, str)
    finished_ok = Signal(dict)
    failed = Signal(str)

    def __init__(self, audio_path, language=None, initial_prompt=None, config=None, mode="whisperx"):
        super().__init__()
        self.audio_path = audio_path
        self.language = language or "en"
        self.initial_prompt = initial_prompt or ""
        self.config = config or {}
        
        # ⚙️ GENTOO DEFENSE: Sanitize and safely assign the mode parameter
        self.mode = str(mode).lower().strip()
        if self.mode not in ("whisperx", "acestep"):
            self.mode = "whisperx"
            
        self._is_cancelled = False
        print(f"[DEBUG] KaggleLyricsWorker initialized successfully. Mode: {self.mode.upper()}")

    def run(self):
        print(f"[DEBUG] KaggleLyricsWorker thread execution started for target file: {self.audio_path}")
        dataset_dir = None
        workspace = None
        try:
            # 1. Setup Kaggle CLI credentials dynamically
            os.environ["KAGGLE_USERNAME"] = self.config.get("kaggle_user", "")
            os.environ["KAGGLE_KEY"] = self.config.get("kaggle_key", "")
            
            if not os.environ["KAGGLE_USERNAME"] or not os.environ["KAGGLE_KEY"]:
                raise ValueError("Missing Kaggle Username or API Key in settings metadata configuration.")

            # 2. Stage and upload the local audio file as a private temporary Dataset
            self.progress.emit(10, "Uploading local audio payload to Kaggle storage...")
            dataset_slug = f"audio-input-{int(time.time())}"
            dataset_dir = os.path.join(os.path.dirname(self.audio_path), "kaggle_data_ws")
            os.makedirs(dataset_dir, exist_ok=True)
            
            shutil.copy2(self.audio_path, os.path.join(dataset_dir, os.path.basename(self.audio_path)))
            
            dataset_meta = {
                "title": f"Audio Input Data {int(time.time())}",
                "id": f"{self.config['kaggle_user']}/{dataset_slug}",
                "licenses": [{"name": "CC0-1.0"}]
            }
            with open(os.path.join(dataset_dir, "dataset-metadata.json"), "w") as f:
                json.dump(dataset_meta, f)
                
            subprocess.run(["kaggle", "datasets", "create", "-p", dataset_dir, "--dir-mode", "zip"], check=True)

            self.progress.emit(30, "Preparing remote execution kernel source code...")
            
            # 3. Define the dual-engine Python payload executed inside the cloud container
            kernel_code = f"""
import os
import json
import torch

print("LOG: Initializing remote environment packages...")
os.system("pip install git+https://github.com omegaconf")

input_dir = "/kaggle/input/{dataset_slug}/"
audio_file = input_dir + os.listdir(input_dir)[0]

device = "cuda" if torch.cuda.is_available() else "cpu"
compute_type = "float16" if device == "cuda" else "int8"
selected_engine = "{self.mode}"

final_transcript = ""

if selected_engine == "whisperx":
    print("LOG: Launching isolated WhisperX workflow pipeline...")
    import whisperx
    audio = whisperx.load_audio(audio_file)
    model = whisperx.load_model("large-v3", device, compute_type=compute_type)
    result = model.transcribe(audio, batch_size=16, language="{self.language}")
    final_transcript = "\\n".join([seg["text"].strip() for seg in result["segments"]])

elif selected_engine == "acestep":
    print("LOG: Provisioning remote ACE-Step package assets...")
    os.system("pip install git+https://github.com")
    import acestep_transcriber
    
    print("LOG: Launching ACE-Step Model transcription processing...")
    final_transcript = acestep_transcriber.transcribe_audio_to_text(
        audio_file, 
        language="{self.language}",
        device=device
    )

# Save the unified output JSON matrix map back to container storage
with open("/kaggle/working/lyrics_output.json", "w") as f:
    json.dump({{"lyrics": final_transcript}}, f)
print("LOG: Processing completed successfully.")
"""

            # 4. Handle runtime directory configurations
            workspace = os.path.join(os.path.dirname(self.audio_path), "kaggle_transcribe_ws")
            os.makedirs(workspace, exist_ok=True)
            
            script_path = os.path.join(workspace, "transcribe_script.py")
            with open(script_path, "w", encoding="utf-8") as f:
                f.write(kernel_code)

            # 5. Generate the Kaggle push manifest specification data profile
            slug = f"vocal-transcription-kernel-{int(time.time())}"
            metadata = {
                "id": f"{self.config['kaggle_user']}/{slug}",
                "title": "Vocal Transcription Kernel Frame",
                "code_file": "transcribe_script.py",
                "language": "python",
                "kernel_type": "script",
                "is_private": True,
                "enable_gpu": True,
                "enable_tpu": False,
                "enable_internet": True,
                "dataset_sources": [f"{self.config['kaggle_user']}/{dataset_slug}"],
                "competition_sources": [],
                "kernel_sources": [],
                "model_sources": []
            }
            
            with open(os.path.join(workspace, "kernel-metadata.json"), "w") as f:
                json.dump(metadata, f)

            self.progress.emit(50, "Pushing computation payload downstream to Kaggle...")
            subprocess.run(["kaggle", "kernels", "push", "-p", workspace], check=True)

            # 6. Continuous execution state inspection ring loop
            self.progress.emit(60, "Job routed. Awaiting cluster initialization...")
            while not self._is_cancelled:
                time.sleep(15)
                status_res = subprocess.run(
                    ["kaggle", "kernels", "status", f"{self.config['kaggle_user']}/{slug}"],
                    capture_output=True, text=True
                )
                output_text = status_res.stdout.lower()
                
                if "complete" in output_text:
                    break
                elif "error" in output_text or "fail" in output_text:
                    raise RuntimeError("Kaggle backend execution returned an error tracking state.")
                
                self.progress.emit(75, f"Kaggle processing active. Engine: [ {self.mode.upper()} ]...")

            # 7. Harvest final asset deliverables
            self.progress.emit(90, "Downloading final text array data mapping tracking matrices...")
            subprocess.run(["kaggle", "kernels", "output", f"{self.config['kaggle_user']}/{slug}", "-p", workspace], check=True)
            
            output_json_path = os.path.join(workspace, "lyrics_output.json")
            if os.path.exists(output_json_path):
                with open(output_json_path, "r") as f:
                    data = json.load(f)
                self.finished_ok.emit(data)
            else:
                raise FileNotFoundError("Target payload dataset token trace file missing from container retrieval space.")

        except Exception as e:
            print(f"[DEBUG] Error caught inside worker thread execution loop: {e}")
            self.failed.emit(str(e))
        finally:
            if dataset_dir and os.path.exists(dataset_dir):
                shutil.rmtree(dataset_dir, ignore_errors=True)
            if workspace and os.path.exists(workspace):
                shutil.rmtree(workspace, ignore_errors=True)

    def cancel(self):
        self._is_cancelled = True

